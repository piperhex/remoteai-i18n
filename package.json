{
  "name": "@remoteai/i18n",
  "version": "0.1.30",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./common": "./src/catalogs/common/index.ts",
    "./desktop": "./src/catalogs/desktop/index.ts",
    "./website": "./src/catalogs/website/index.ts",
    "./catalogs/*": "./src/catalogs/*/index.ts",
    "./loader": "./src/catalogs/loader.ts",
    "./client": "./src/catalogs/client/index.ts",
    "./errors": "./src/errors.ts",
    "./copy/*": "./src/copy/*.ts",
    "./website-content/*.json": "./src/website-content/*.json",
    "./website-content/*": "./src/website-content/*.ts",
    "./legal/*.json": "./src/legal/*.json",
    "./legal/*": "./src/legal/*.ts",
    "./error-templates": "./src/errorTemplates.json",
    "./tooling/dream-skin": "./tooling/dreamSkin.mjs"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check && tsc --noEmit && vitest run",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "pack:release": "node scripts/pack.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "typescript": ">=5.6 <6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vitest": "^4.1.9",
    "jsdom": "^26.1.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.12"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/piperhex/remoteai-i18n.git"
  },
  "engines": {
    "node": ">=20.19"
  }
}
